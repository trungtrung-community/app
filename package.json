{
  "name": "trungtrung-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:design": "node scripts/sync-design.ts",
    "sync:sounds": "node scripts/build-sounds.ts",
    "sync": "npm run sync:design && npm run sync:content && npm run sync:cards && npm run sync:sounds",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:adherence && npm run check:test-shape && npm run depcruise && npm run sync:design -- --check && npm run check:content && npm run sync:cards -- --check && npm run check:sounds",
    "validate:ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:adherence && npm run check:test-shape && npm run depcruise && npm run check:sounds",
    "sync:content": "node scripts/sync-content.ts",
    "check:content": "node scripts/sync-content.ts --check",
    "sync:cards": "node scripts/sync-cards.ts",
    "check:adherence": "node scripts/check-adherence.ts",
    "check:test-shape": "node scripts/check-test-shape.ts",
    "prepare": "husky",
    "depcruise": "depcruise src app scripts tests",
    "depcruise:graph": "depcruise src app scripts --output-type dot",
    "check:sounds": "node scripts/build-sounds.ts --check"
  },
  "dependencies": {
    "@expo-google-fonts/gabarito": "^0.4.2",
    "@expo-google-fonts/noto-serif-tibetan": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.11",
    "expo": "~57.0.14",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.11.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vite-plugin-babel": "^1.7.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
