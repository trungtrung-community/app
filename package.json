{
  "name": "trungtrung-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:design": "node scripts/sync-design.ts",
    "sync": "npm run sync:design && npm run sync:content && npm run sync:cards",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run sync:design -- --check && npm run check:content && npm run sync:cards -- --check",
    "sync:content": "node scripts/sync-content.ts",
    "check:content": "node scripts/sync-content.ts --check",
    "sync:cards": "node scripts/sync-cards.ts"
  },
  "dependencies": {
    "@expo-google-fonts/gabarito": "^0.4.2",
    "@expo-google-fonts/noto-serif-tibetan": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.10",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.11.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
